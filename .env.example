# Konfigurasi Supabase (Opsional - jika kosong, aplikasi berjalan otomatis dengan mode Sinkronisasi Lokal / Demo)
# Isi variabel ini pada Vercel Project Settings -> Environment Variables untuk mengaktifkan database PostgreSQL & Realtime Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
